<Project>
   <PropertyGroup>
      <LangVersion>latest</LangVersion>

      <VersionPrefix>1.0.0</VersionPrefix>
      <!-- Beta counter; leave empty for a stable release -->
      <BetaNumber></BetaNumber>
      <!-- Release candidate counter; leave empty for a stable release -->
      <ReleaseCandidateNumber>1</ReleaseCandidateNumber>

      <!-- Numeric identity: unique per prerelease so Visual Studio reloads the analyzer instead of serving a cached copy -->
      <AssemblyVersion Condition="'$(BetaNumber)' != ''">$(VersionPrefix).$(BetaNumber)</AssemblyVersion>
      <AssemblyVersion Condition="'$(ReleaseCandidateNumber)' != ''">$(VersionPrefix).$(ReleaseCandidateNumber)00</AssemblyVersion>
      <AssemblyVersion Condition="'$(BetaNumber)' == '' AND '$(ReleaseCandidateNumber)' == ''">$(VersionPrefix).0</AssemblyVersion>
      <FileVersion>$(AssemblyVersion)</FileVersion>

      <!-- Display and package version keep the beta label -->
      <VersionSuffix Condition="'$(BetaNumber)' != ''">beta$(BetaNumber)</VersionSuffix>
      <VersionSuffix Condition="'$(ReleaseCandidateNumber)' != ''">rc$(ReleaseCandidateNumber)</VersionSuffix>
      <Version Condition="'$(VersionSuffix)' != ''">$(VersionPrefix)-$(VersionSuffix)</Version>
      <Version Condition="'$(VersionSuffix)' == ''">$(VersionPrefix)</Version>
      <PackageVersion>$(Version)</PackageVersion>
      <InformationalVersion>$(Version)</InformationalVersion>
   </PropertyGroup>
   
   <PropertyGroup Condition="'$(Configuration)'=='Debug'">
      <DocumentationFile>bin\Debug\$(MSBuildProjectName).xml</DocumentationFile>
      <CodeAnalysisRuleSet>..\Debug.ruleset</CodeAnalysisRuleSet>
   </PropertyGroup>

   <PropertyGroup Condition="'$(Configuration)'=='Release'">
      <DocumentationFile>bin\Release\$(MSBuildProjectName).xml</DocumentationFile>
      <CodeAnalysisRuleSet>..\Release.ruleset</CodeAnalysisRuleSet>
      <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
      <MSTestAnalysisMode>Recommended</MSTestAnalysisMode>
   </PropertyGroup>

   <ItemGroup>
     <Analyzer Include="..\binaries\Reihitsu.Core.dll" />
     <Analyzer Include="..\binaries\Reihitsu.Analyzer.dll" />
     <Analyzer Include="..\binaries\Reihitsu.Analyzer.CodeFixes.dll" />
     <Analyzer Include="..\binaries\Reihitsu.Formatter.dll" />
   </ItemGroup>
</Project>