<Project>
   <!--
      The SDK defaults Configuration to Debug only after this file is imported, so a build that names
      no configuration (dotnet run, or dotnet build without -c) would otherwise skip the
      configuration-specific properties below, including the ruleset. Apply the same default here.
   -->
   <PropertyGroup>
      <Configuration Condition="'$(Configuration)' == ''">Debug</Configuration>
   </PropertyGroup>

   <PropertyGroup>
      <LangVersion>latest</LangVersion>

      <VersionPrefix>1.5.0</VersionPrefix>
      <!-- Beta counter; leave empty for a stable release -->
      <BetaNumber></BetaNumber>
      <!-- Release candidate counter; leave empty for a stable release -->
      <ReleaseCandidateNumber></ReleaseCandidateNumber>

      <!-- Numeric identity: unique per prerelease so Visual Studio reloads the analyzer instead of serving a cached copy -->
      <AssemblyVersion Condition="'$(BetaNumber)' != ''">$(VersionPrefix).$(BetaNumber)</AssemblyVersion>
      <AssemblyVersion Condition="'$(ReleaseCandidateNumber)' != ''">$(VersionPrefix).$(ReleaseCandidateNumber)00</AssemblyVersion>
      <AssemblyVersion Condition="'$(BetaNumber)' == '' AND '$(ReleaseCandidateNumber)' == ''">$(VersionPrefix).0</AssemblyVersion>
      <FileVersion>$(AssemblyVersion)</FileVersion>

      <!-- Display and package version keep the beta label -->
      <VersionSuffix Condition="'$(BetaNumber)' != ''">beta$(BetaNumber)</VersionSuffix>
      <VersionSuffix Condition="'$(ReleaseCandidateNumber)' != ''">rc$(ReleaseCandidateNumber)</VersionSuffix>
      <Version Condition="'$(VersionSuffix)' != ''">$(VersionPrefix)-$(VersionSuffix)</Version>
      <Version Condition="'$(VersionSuffix)' == ''">$(VersionPrefix)</Version>
      <PackageVersion>$(Version)</PackageVersion>
      <InformationalVersion>$(Version)</InformationalVersion>
   </PropertyGroup>

   <PropertyGroup>
      <!-- The one Roslyn version every non-Testing Microsoft.CodeAnalysis* package reference uses -->
      <RoslynVersion>5.12.0</RoslynVersion>
   </PropertyGroup>
   
   <PropertyGroup Condition="'$(Configuration)'=='Debug'">
      <DocumentationFile>bin\Debug\$(MSBuildProjectName).xml</DocumentationFile>
      <CodeAnalysisRuleSet>$(MSBuildThisFileDirectory)Debug.ruleset</CodeAnalysisRuleSet>
   </PropertyGroup>

   <PropertyGroup Condition="'$(Configuration)'=='Release'">
      <DocumentationFile>bin\Release\$(MSBuildProjectName).xml</DocumentationFile>
      <CodeAnalysisRuleSet>$(MSBuildThisFileDirectory)Release.ruleset</CodeAnalysisRuleSet>
      <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
      <MSTestAnalysisMode>Recommended</MSTestAnalysisMode>
   </PropertyGroup>

   <ItemGroup>
     <Analyzer Include="$(MSBuildThisFileDirectory)binaries\Reihitsu.Core.dll" />
     <Analyzer Include="$(MSBuildThisFileDirectory)binaries\Reihitsu.Analyzer.dll" />
     <Analyzer Include="$(MSBuildThisFileDirectory)binaries\Reihitsu.Analyzer.CodeFixes.dll" />
     <Analyzer Include="$(MSBuildThisFileDirectory)binaries\Reihitsu.Formatter.dll" />
   </ItemGroup>

   <!--
      The root reihitsu.json holds the repository's own limits. It is passed to the analyzers above in every project
      and every configuration, so the build enforces those limits as the self-hosting scan does.
   -->
   <ItemGroup>
     <AdditionalFiles Include="$(MSBuildThisFileDirectory)reihitsu.json" />
   </ItemGroup>

   <!--
      The analyzers above are loaded directly, not through the package, so the package's build file is imported
      here: it makes the MSBuild properties that tell test code from production code visible to the analyzers.
   -->
   <Import Project="$(MSBuildThisFileDirectory)src\Reihitsu.Analyzer.Package\buildTransitive\Reihitsu.Analyzer.targets" />

   <ItemGroup>
     <PackageReference Include="SonarAnalyzer.CSharp" Version="10.37.0.15768" PrivateAssets="all" />
   </ItemGroup>
</Project>