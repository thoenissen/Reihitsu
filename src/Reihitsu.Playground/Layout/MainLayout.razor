@inherits LayoutComponentBase

<div class="app-shell">
    <header class="app-header">
        <div class="app-header-inner">
            <span class="app-title">Reihitsu Playground</span>
            <a class="app-github-link" href="https://github.com/thoenissen/Reihitsu" target="_blank" rel="noopener noreferrer">GitHub</a>
        </div>
    </header>

    <main class="app-main">
        @Body
    </main>

    <footer class="app-footer">
        <span>Reihitsu</span>
        <span class="app-footer-sep">&middot;</span>
        <span>v@(PlaygroundVersion.FormatterVersion)</span>
        <span class="app-footer-sep">&middot;</span>
        <span>&copy; 2026 Seth (thoenissen)</span>
    </footer>
</div>
