@page "/"

<PageTitle>Reihitsu Playground</PageTitle>

<h1>Format C# with Reihitsu</h1>
<p>
    Paste C# source below and format it with the Reihitsu formatter.
    Formatting runs entirely in your browser; nothing is uploaded anywhere.
</p>

<div class="playground-grid">
    <div class="playground-column">
        <label for="playground-input">Input</label>
        <div class="playground-editor">
            <div class="playground-editor-layers">
                <pre class="playground-code playground-input-copy" aria-hidden="true">@_inputHighlighting.Content</pre>
                <textarea id="playground-input" class="playground-code" spellcheck="false" wrap="off" @bind="_input" @bind:event="oninput" @bind:after="OnInputChanged"></textarea>
            </div>
        </div>
    </div>
    <div class="playground-column">
        <label id="playground-output-label">Formatted output</label>
        <pre id="playground-output" class="playground-code playground-output" role="region" tabindex="0" aria-labelledby="playground-output-label">@_outputContent</pre>
    </div>
</div>

<button type="button" @onclick="FormatInput">Format</button>

@if (_messageLines.Count > 0)
{
    <div class="playground-message" role="alert">
        @foreach (var line in _messageLines)
        {
            <div>@line</div>
        }
    </div>
}
